{
  "id": "plan-generate-verify",
  "label": "Plan -> Generate -> Verify",
  "description": "Strict Debugger pattern: planner stages must complete before generator stages, then verifier and curator stages close the run.",
  "modeBindings": [
    "debugger"
  ],
  "finalStatusOwner": "runtime",
  "stages": [
    {
      "id": "pattern.stage.plan",
      "label": "Plan",
      "stage": "plan",
      "phase": "planner",
      "requiresApproval": true
    },
    {
      "id": "pattern.stage.generate",
      "label": "Generate",
      "stage": "investigate",
      "phase": "generator"
    },
    {
      "id": "pattern.stage.verify",
      "label": "Verify",
      "stage": "fix_verify",
      "phase": "evaluator",
      "verifierAgents": [
        "skeptic_agent",
        "curator_agent"
      ]
    }
  ]
}
