{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.rdc-agent.app",
  "productName": "RDC-Agent",
  "copyright": "Copyright © 2026 RDC-Agent Contributors",
  "directories": {
    "output": "release",
    "buildResources": "resources"
  },
  "files": [
    "out/**/*",
    "resources/agent-runtime/**/*",
    "resources/knowledge/**/*"
  ],
  "asarUnpack": [
    "resources/agent-runtime/hooks/**/*.mjs"
  ],
  "extraResources": [
    {
      "from": "resources/agent-runtime/hooks",
      "to": "agent-runtime/hooks",
      "filter": ["*.mjs"]
    },
    {
      "from": "resources/brand/rdc-agent-logo.png",
      "to": "brand/rdc-agent-logo.png"
    }
  ],
  "forceCodeSigning": false,
  "electronDist": "node_modules/electron/dist",
  "win": {
    "executableName": "RdcAgent",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ],
    "icon": "resources/icons/icon.ico",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "signAndEditExecutable": true
  },
  "nsis": {
    "artifactName": "${productName}-${version}-${arch}-setup.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  }
}
