{
  "name": "rdc-agent",
  "version": "0.6.0-rc.8",
  "description": "RDC-Agent — Electron desktop app for RenderDoc .rdc capture analysis with agentic Debugger/Ask workflows",
  "author": "RDC-Agent Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haolange/RDC-Agent.git"
  },
  "homepage": "https://github.com/haolange/RDC-Agent",
  "bugs": {
    "url": "https://github.com/haolange/RDC-Agent/issues"
  },
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "design:dev": "vite --config designs/rdc-agent-design-system/vite.config.ts",
    "design:build": "vite build --config designs/rdc-agent-design-system/vite.config.ts",
    "dev": "node scripts/launch-rdc-agent.mjs --mode desktop-dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "start": "node scripts/launch-rdc-agent.mjs --mode desktop",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "check:architecture": "node scripts/check-architecture.mjs && node scripts/check-orchestrator-facade.mjs",
    "check:orchestrator-facade": "node scripts/check-orchestrator-facade.mjs",
    "fidelity:extract": "node scripts/extract-fidelity-contract.mjs && node scripts/extract-shared-exports.mjs",
    "check:fidelity": "node scripts/check-fidelity.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "check:ui-contract": "node scripts/check-ui-contract.mjs",
    "check:request-cache-profile": "node --test scripts/request-cache-profile.test.mjs",
    "check:renderer-structure": "node --test scripts/renderer-source-analysis.test.mjs && node scripts/check-renderer-structure.mjs",
    "check:shared-exports": "node scripts/check-shared-exports.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check:invariants": "node scripts/check-invariants.mjs",
    "check:strict-next": "node node_modules/typescript/bin/tsc -p tsconfig.strict-next.json --noEmit",
    "check:work-process": "vitest run src/main/testing/gates/behaviorChecks.test.ts -t work-process",
    "check:work-process-tool-coverage": "node scripts/check-work-process-tool-coverage.mjs",
    "check:conversation-branch": "vitest run src/main/testing/gates/behaviorChecks.test.ts -t conversation-branch",
    "check:reasoning-delivery": "vitest run src/main/testing/gates/behaviorChecks.test.ts -t \"reasoning delivery\"",
    "check:agent-runtime": "node scripts/check-agent-runtime.mjs",
    "check:tool-system": "node scripts/check-tool-system.mjs",
    "check:browser-capability": "vitest run src/main/testing/gates/behaviorChecks.test.ts -t \"browser capability\"",
    "check:provider-system": "node scripts/check-provider-system.mjs",
    "check:agent-tool-capability": "node scripts/check-agent-tool-capability.mjs",
    "check:provider-catalog": "vitest run src/main/provider-catalog/catalogCompiler.test.ts && node scripts/check-agent-tool-capability.mjs",
    "check:settings-agents": "vitest run src/main/testing/gates/behaviorChecks.test.ts -t \"settings agents\"",
    "check:i18n": "vitest run src/main/testing/gates/behaviorChecks.test.ts -t \"i18n catalogs\"",
    "check:appearance": "vitest run src/main/testing/gates/behaviorChecks.test.ts -t \"appearance theme\"",
    "check:host-platform": "vitest run src/main/testing/gates/behaviorChecks.test.ts -t \"host platform gate\"",
    "check:session-projection": "node scripts/check-session-projection.mjs",
    "check:right-rail": "node scripts/check-right-rail.mjs",
    "check:knowledge-system": "node scripts/check-knowledge-system.mjs",
    "check:investigation-system": "node scripts/check-investigation-system.mjs",
    "check:legacy-residue": "node scripts/check-legacy-residue.mjs",
    "check:acceptance-ledger": "node scripts/check-acceptance-ledger.mjs",
    "check:git-diff": "node scripts/check-git-diff.mjs",
    "check:repository-hygiene": "node scripts/check-repository-hygiene.mjs",
    "check:scoped-resources": "vitest run src/main/runtime/ScopedResourceResolver.test.ts src/main/runtime/ScopedRuntimeService.test.ts",
    "check:project-instructions": "vitest run src/main/runtime/ScopedInstructionResolver.test.ts",
    "check:prompt-plan-snapshot": "vitest run src/main/agent-runtime/prompt/PromptPlanBuilder.test.ts src/main/agent-runtime/prompt/RequestEnvelopeBuilder.test.ts",
    "check:skills": "vitest run src/main/settings/agent-manifests/AgentRuntimeConfigService.test.ts",
    "check:rdc-tool-guides": "node scripts/generate-rdc-tool-guides.mjs --check",
    "check:hooks": "vitest run src/main/hooks src/main/runtime/ScopedRuntimeService.test.ts",
    "check:memory-policy": "vitest run src/main/agent-runtime/memory/MemoryStore.test.ts",
    "check:contracts": "vitest run src/main/testing/contracts",
    "check:coverage-ratchet": "node scripts/check-coverage-ratchet.mjs",
    "check:release-config": "node scripts/check-release-config.mjs",
    "release:checksums": "node scripts/release/generate-checksums.mjs",
    "release:sbom": "node scripts/release/generate-sbom.mjs",
    "check:release-package": "node scripts/release/verify-package.mjs",
    "check:gates": "node scripts/check-invariants.mjs && node node_modules/typescript/bin/tsc -p tsconfig.strict-next.json --noEmit && node scripts/check-repository-hygiene.mjs && node scripts/check-architecture.mjs && node scripts/check-orchestrator-facade.mjs && node scripts/check-fidelity.mjs && node scripts/check-shared-exports.mjs && node node_modules/vitest/vitest.mjs run src/main/testing/gates/behaviorChecks.test.ts && node scripts/check-work-process-tool-coverage.mjs && node scripts/check-agent-runtime.mjs && node scripts/check-tool-system.mjs && node scripts/check-session-projection.mjs && node scripts/check-right-rail.mjs && node scripts/check-knowledge-system.mjs && node scripts/check-investigation-system.mjs && node scripts/check-legacy-residue.mjs && node scripts/check-acceptance-ledger.mjs && node scripts/check-provider-system.mjs && node scripts/check-release-config.mjs && node scripts/check-design-tokens.mjs && node scripts/check-ui-contract.mjs && node scripts/check-doc-references.mjs && node scripts/check-renderer-structure.mjs && node scripts/generate-rdc-tool-guides.mjs --check && node scripts/check-identity.mjs && node scripts/check-secrets.mjs",
    "start:human": "node scripts/launch-rdc-agent.mjs --mode desktop",
    "start:human:dev": "node scripts/launch-rdc-agent.mjs --mode desktop-dev",
    "start:agent-browser": "node scripts/launch-rdc-agent.mjs --mode browser",
    "start:agent-browser:dev": "node scripts/launch-rdc-agent.mjs --mode browser-dev",
    "smoke:agent-browser": "node scripts/smoke-agent-browser-qa.mjs",
    "smoke:desktop": "node scripts/smoke-desktop-health.mjs",
    "start:prepare": "node scripts/launch-rdc-agent.mjs --mode prepare-only",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --project node --coverage --coverage.reportsDirectory=coverage/node --coverage.include='src/{main,shared,preload}/**/*.{ts,tsx}' && node scripts/write-coverage-summary.mjs coverage/node/coverage-final.json coverage/coverage-summary.json",
    "test:coverage:renderer": "vitest run --project renderer --coverage --coverage.reportsDirectory=coverage/renderer --coverage.include='src/renderer/**/*.{ts,tsx}' && node scripts/write-coverage-summary.mjs coverage/renderer/coverage-final.json coverage/renderer/coverage-summary.json",
    "check:identity": "node scripts/check-identity.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "brand:icons": "node --experimental-strip-types scripts/render-product-icons.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "3.0.14",
    "@aws-sdk/credential-providers": "3.1057.0",
    "@jerome-benoit/sap-ai-provider-v2": "4.8.0",
    "@sap-ai-sdk/ai-api": "2.12.0",
    "ai": "6.0.226",
    "aws4fetch": "1.0.20",
    "fflate": "^0.8.3",
    "gitlab-ai-provider": "6.11.1",
    "pdfjs-dist": "^6.5.438",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "fast-uri": "3.1.2",
    "postcss": "8.5.15"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@swc/core": "^1.16.22",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/runner": "^4.1.11",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "gpt-tokenizer": "^3.4.0",
    "happy-dom": "^21.0.4",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "mermaid": "^11.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "zustand": "^4.5.7"
  }
}
