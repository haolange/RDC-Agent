{
  "name": "rdc-agent",
  "version": "0.6.0",
  "description": "RDC-Agent — Electron desktop app for RenderDoc .rdc capture analysis with agentic Debugger/Ask workflows",
  "author": "RDC-Agent Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haolange/RDC-Agent.git"
  },
  "homepage": "https://github.com/haolange/RDC-Agent",
  "bugs": {
    "url": "https://github.com/haolange/RDC-Agent/issues"
  },
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/launch-rdc-agent.mjs --mode desktop-dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "start": "node scripts/launch-rdc-agent.mjs --mode desktop",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "check:architecture": "node scripts/check-architecture.mjs && node scripts/check-orchestrator-facade.mjs",
    "check:orchestrator-facade": "node scripts/check-orchestrator-facade.mjs",
    "fidelity:extract": "node scripts/extract-fidelity-contract.mjs && node scripts/extract-shared-exports.mjs",
    "check:fidelity": "node scripts/check-fidelity.mjs",
    "check:shared-exports": "node scripts/check-shared-exports.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "check:work-process": "node scripts/check-work-process-presentation.mjs",
    "check:work-process-tool-coverage": "node scripts/check-work-process-tool-coverage.mjs",
    "check:conversation-branch": "node scripts/check-conversation-branch.mjs",
    "check:reasoning-delivery": "node scripts/check-reasoning-delivery.mjs",
    "check:agent-runtime": "node scripts/check-agent-runtime.mjs",
    "check:tool-system": "node scripts/check-tool-system.mjs",
    "check:browser-capability": "node scripts/check-browser-capability.mjs",
    "check:provider-system": "node scripts/check-provider-system.mjs",
    "check:agent-tool-capability": "node scripts/check-agent-tool-capability.mjs",
    "check:provider-catalog": "vitest run src/shared/provider-catalog/compiler.test.ts src/shared/provider-catalog/agentToolCapabilityAudit.test.ts src/shared/utils/agentToolCapability.test.ts && node scripts/check-agent-tool-capability.mjs",
    "check:settings-agents": "node scripts/check-settings-agents.mjs",
    "check:appearance": "node scripts/check-appearance.mjs",
    "check:session-projection": "node scripts/check-session-projection.mjs",
    "check:right-rail": "node scripts/check-right-rail.mjs",
    "check:knowledge-system": "node scripts/check-knowledge-system.mjs",
    "check:investigation-system": "node scripts/check-investigation-system.mjs",
    "check:repository-hygiene": "node scripts/check-repository-hygiene.mjs",
    "check:scoped-resources": "vitest run src/main/runtime/ScopedResourceResolver.test.ts src/main/runtime/RdxRuntimeService.test.ts",
    "check:project-instructions": "vitest run src/main/runtime/ScopedInstructionResolver.test.ts",
    "check:prompt-plan-snapshot": "vitest run src/main/agent-runtime/prompt/PromptPlanBuilder.test.ts src/main/agent-runtime/prompt/RequestEnvelopeBuilder.test.ts",
    "check:skills": "vitest run src/main/settings/AgentRuntimeConfigService.test.ts",
    "check:hooks": "vitest run src/main/hooks src/main/runtime/RdxRuntimeService.test.ts",
    "check:memory-policy": "vitest run src/main/agent-runtime/memory/MemoryStore.test.ts",
    "check:contracts": "vitest run src/main/testing/contracts",
    "check:coverage-ratchet": "node scripts/check-coverage-ratchet.mjs",
    "check:release-config": "node scripts/check-release-config.mjs",
    "release:checksums": "node scripts/release/generate-checksums.mjs",
    "release:sbom": "node scripts/release/generate-sbom.mjs",
    "check:gates": "node scripts/check-repository-hygiene.mjs && node scripts/check-architecture.mjs && node scripts/check-orchestrator-facade.mjs && node scripts/check-fidelity.mjs && node scripts/check-shared-exports.mjs && node scripts/check-work-process-presentation.mjs && node scripts/check-work-process-tool-coverage.mjs && node scripts/check-conversation-branch.mjs && node scripts/check-reasoning-delivery.mjs && node scripts/check-agent-runtime.mjs && node scripts/check-tool-system.mjs && node scripts/check-browser-capability.mjs && node scripts/check-appearance.mjs && node scripts/check-session-projection.mjs && node scripts/check-right-rail.mjs && node scripts/check-knowledge-system.mjs && node scripts/check-investigation-system.mjs && node scripts/check-settings-agents.mjs && node scripts/check-provider-system.mjs && node scripts/check-release-config.mjs",
    "start:human": "node scripts/launch-rdc-agent.mjs --mode desktop",
    "start:human:dev": "node scripts/launch-rdc-agent.mjs --mode desktop-dev",
    "start:agent-browser": "node scripts/launch-rdc-agent.mjs --mode browser",
    "start:agent-browser:dev": "node scripts/launch-rdc-agent.mjs --mode browser-dev",
    "smoke:agent-browser": "node scripts/smoke-agent-browser-qa.mjs",
    "smoke:desktop": "node scripts/smoke-desktop-health.mjs",
    "start:prepare": "node scripts/launch-rdc-agent.mjs --mode prepare-only",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/provider": "3.0.14",
    "@aws-sdk/credential-providers": "3.1057.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@jerome-benoit/sap-ai-provider-v2": "4.8.0",
    "@sap-ai-sdk/ai-api": "2.12.0",
    "@uiw/react-codemirror": "^4.25.11",
    "ai": "6.0.226",
    "aws4fetch": "1.0.20",
    "electron-store": "^8.1.0",
    "gitlab-ai-provider": "6.11.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "mermaid": "^11.16.0",
    "openai": "^6.38.0",
    "pdfjs-dist": "^6.2.108",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "uuid": "^9.0.0",
    "yaml": "^2.3.4",
    "zod": "^4.3.6",
    "zustand": "^4.5.0"
  },
  "overrides": {
    "fast-uri": "3.1.2",
    "postcss": "8.5.15"
  },
  "devDependencies": {
    "@swc/core": "^1.15.33",
    "@types/node": "^24.12.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "4.1.8",
    "@vitest/runner": "^4.1.8",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "gpt-tokenizer": "^3.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.3",
    "vitest": "^4.1.8"
  }
}
