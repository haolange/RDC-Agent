{
  "name": "rdc-agent",
  "version": "1.0.0",
  "description": "RenderDoc Debug Agent - Vertical Framework",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "check:architecture": "node scripts/check-architecture.mjs",
    "fidelity:extract": "node scripts/extract-fidelity-contract.mjs && node scripts/extract-shared-exports.mjs",
    "check:fidelity": "node scripts/check-fidelity.mjs",
    "check:shared-exports": "node scripts/check-shared-exports.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "check:provider-system": "node scripts/check-provider-system.mjs",
    "check:settings-agents": "node scripts/check-settings-agents.mjs",
    "start:human": "scripts\\start-rdc-agent.cmd",
    "start:human:dev": "scripts\\start-rdc-agent-dev.cmd",
    "start:agent-browser": "scripts\\start-browser-session.cmd"
  },
  "dependencies": {
    "openai": "^6.38.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-store": "^8.1.0",
    "uuid": "^9.0.0",
    "yaml": "^2.3.4",
    "zod": "^4.3.6",
    "zustand": "^4.5.0"
  },
  "overrides": {
    "fast-uri": "3.1.2",
    "postcss": "8.5.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@swc/core": "^1.15.33",
    "@types/node": "^24.12.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.3"
  },
  "build": {
    "appId": "com.rdc-agent.app",
    "productName": "RdcAgent",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/agent-runtime/**/*",
      "resources/knowledge/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/resources/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/resources/icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/resources/icons/icon.png"
    }
  }
}
