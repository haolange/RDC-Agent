{
  "name": "rdc-agent",
  "version": "1.0.0",
  "description": "RenderDoc Debug Agent - Vertical Framework",
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/launch-rdc-agent.mjs --mode desktop-dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "check:architecture": "node scripts/check-architecture.mjs",
    "fidelity:extract": "node scripts/extract-fidelity-contract.mjs && node scripts/extract-shared-exports.mjs",
    "check:fidelity": "node scripts/check-fidelity.mjs",
    "check:shared-exports": "node scripts/check-shared-exports.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "check:work-process": "node scripts/check-work-process-presentation.mjs",
    "check:work-process-tool-coverage": "node scripts/check-work-process-tool-coverage.mjs",
    "check:conversation-branch": "node scripts/check-conversation-branch.mjs",
    "check:reasoning-delivery": "node scripts/check-reasoning-delivery.mjs",
    "check:agent-runtime": "node scripts/check-agent-runtime.mjs",
    "check:tool-system": "node scripts/check-tool-system.mjs",
    "check:provider-system": "node scripts/check-provider-system.mjs",
    "check:settings-agents": "node scripts/check-settings-agents.mjs",
    "check:scoped-resources": "vitest run src/main/runtime/ScopedResourceResolver.test.ts src/main/runtime/RdxRuntimeService.test.ts",
    "check:project-instructions": "vitest run src/main/runtime/ScopedInstructionResolver.test.ts",
    "check:prompt-plan-snapshot": "vitest run src/main/agent-runtime/prompt/PromptPlanBuilder.test.ts src/main/agent-runtime/prompt/RequestEnvelopeBuilder.test.ts",
    "check:skills": "vitest run src/main/settings/AgentRuntimeConfigService.test.ts",
    "check:hooks": "vitest run src/main/hooks/HookEngine.test.ts src/main/runtime/RdxRuntimeService.test.ts",
    "check:memory-policy": "vitest run src/main/agent-runtime/memory/MemoryStore.test.ts",
    "start:human": "node scripts/launch-rdc-agent.mjs --mode desktop",
    "start:human:dev": "node scripts/launch-rdc-agent.mjs --mode desktop-dev",
    "start:agent-browser": "node scripts/launch-rdc-agent.mjs --mode browser",
    "start:agent-browser:dev": "node scripts/launch-rdc-agent.mjs --mode browser-dev",
    "start:prepare": "node scripts/launch-rdc-agent.mjs --mode prepare-only",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-store": "^8.1.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "mermaid": "^11.16.0",
    "openai": "^6.38.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "uuid": "^9.0.0",
    "yaml": "^2.3.4",
    "zod": "^4.3.6",
    "zustand": "^4.5.0"
  },
  "overrides": {
    "fast-uri": "3.1.2",
    "postcss": "8.5.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@swc/core": "^1.15.33",
    "@types/node": "^24.12.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/runner": "^4.1.8",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "gpt-tokenizer": "^3.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.3",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "com.rdc-agent.app",
    "productName": "RdcAgent",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/agent-runtime/**/*",
      "resources/knowledge/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/resources/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/resources/icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/resources/icons/icon.png"
    }
  }
}
